# Server-only settings are configured on the host and must never be committed.
DATABASE_URL=postgres://user:password@host:5432/database
TOKEN_SECRET=replace-with-a-long-random-value
ADMIN_PASSWORD_HASH=sha256-hash-of-admin-password
IIKO_API_BASE=https://api-ru.iiko.services
IIKO_APP_ID=app-id-from-iiko-developer-portal
IIKO_API_LOGIN=api-key-from-iiko-web
IIKO_CLIENT_SECRET=client-secret-from-iiko-developer-portal
IIKO_ORGANIZATION_ID=organization-uuid
IIKO_WEBHOOK_TOKEN=long-random-secret-for-iiko-webhooks
