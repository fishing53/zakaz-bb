# Server-only settings are configured on the host and must never be committed.
DATABASE_URL=postgres://user:password@host:5432/database
TOKEN_SECRET=replace-with-a-long-random-value
PUBLIC_APP_URL=https://order.brooklynbowl.ru
ADMIN_PASSWORD_HASH=sha256-hash-of-admin-password
IIKO_CONFIG_ENCRYPTION_KEY=64-hex-characters-generated-on-the-server
# Optional only when the installation uses a different public domain:
# IIKO_WEBHOOK_URL=https://example.com/api/v1/iiko/webhook
