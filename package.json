{
  "name": "brooklyn-bowl-kiosk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:images": "node scripts/mirror-menu-images.mjs",
    "build": "tsc --noEmit && vite build",
    "android:sync": "npm run build && cap sync android",
