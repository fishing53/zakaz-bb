{
  "name": "brooklyn-bowl-kiosk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "sync:images": "node scripts/mirror-menu-images.mjs",
    "build": "tsc --noEmit && vite build",
    "build:waiter": "vite build --config waiter/vite.config.ts",
    "android:sync": "npm run build && cap sync android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:critical": "npm run check && npm test",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/push-notifications": "^8.0.2",
    "@capgo/capacitor-updater": "^8.51.2",
    "firebase-admin": "^14.2.0",
    "lucide-static": "^1.31.0",
    "pg": "^8.13.3",
    "qrcode": "^1.5.4",
    "ws": "^8.21.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
