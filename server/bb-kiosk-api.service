[Unit]
Description=BB Kiosk API
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/bb-kiosk-api
EnvironmentFile=/etc/bb-kiosk-api.env
ExecStart=/usr/bin/node /opt/bb-kiosk-api/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
